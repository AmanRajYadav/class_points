node_modules/
build/
dist/
coverage/
.DS_Store
*.log

# Secrets. .env.local holds the Supabase URL and anon key; only the template
# is tracked.
.env*
!.env.example

# Machine-specific Claude Code permissions
.claude/settings.local.json

# Agent skills. The vendored copy under .agents/ and the symlinks under
# .claude/skills/ are both reproducible from skills-lock.json via
# `npx skills add supabase/agent-skills` — and the symlinks hold absolute
# paths, so committing them would break on any other machine.
.agents/
.claude/skills/

# Generated credential scripts. These contain plaintext student passwords and
# the repository is public — the file is meant to live on your machine only.
supabase/*_logins.sql
